REACT_APP_API_URL=https://your-backend.railway.app
JWT_SECRET=replace-with-long-random-string
DATABASE_URL=postgresql://user:pass@host:port/db
SEED_PASSWORD_YAHOSKA=
SEED_PASSWORD_KATY=
ANTHROPIC_API_KEY=
# Machine access for Igor (Bearer token or x-api-key). Never commit the live value.
OLICOMM_API_KEY=
